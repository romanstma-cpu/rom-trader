{
  "name": "rom-trader",
  "productName": "ROM Trader",
  "version": "1.7.2",
  "description": "A simple Kalshi auto-trading bot. Momentum engine, live dashboard, trade history.",
  "main": "dist-electron/main.js",
  "license": "MIT",
  "author": {
    "name": "ROM",
    "url": "https://romapps.xyz"
  },
  "homepage": "https://romapps.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/romanstma-cpu/rom-trader.git"
  },
  "bugs": {
    "url": "https://github.com/romanstma-cpu/rom-trader/issues"
  },
  "scripts": {
    "build:renderer": "vite build",
    "build:main": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --external:electron --external:electron-updater --outdir=dist-electron --format=cjs",
    "build": "npm run build:renderer && npm run build:main",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win",
    "typecheck": "tsc --noEmit",
    "playtest": "esbuild test/playtest.ts --bundle --platform=node --alias:electron=./test/electron-stub.js --outfile=test/playtest.js && node test/playtest.js",
    "smoke": "esbuild test/headless.ts --bundle --platform=node --alias:electron=./test/electron-stub.js --outfile=test/headless.js && node test/headless.js",
    "simulate": "esbuild scripts/simulate.ts --bundle --platform=node --alias:electron=./test/electron-stub.js --outfile=scripts/simulate.js && node scripts/simulate.js",
    "traycheck": "esbuild test/tray-check.ts --bundle --platform=node --outfile=test/tray-check.js --format=cjs && node test/tray-check.js",
    "dpapi": "esbuild test/dpapi-check.ts --bundle --platform=node --external:electron --outfile=test/dpapi-check.js --format=cjs && electron test/dpapi-check.js",
    "check": "npm run typecheck && npm run playtest",
    "check:all": "npm run typecheck && npm run playtest && npm run dpapi && npm run build && npm run traycheck"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  },
  "build": {
    "appId": "trade.rom.app",
    "productName": "ROM Trader",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "assets/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "romanstma-cpu",
        "repo": "rom-apps"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "ROM-Trader-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "electron@43.4.1": true,
    "esbuild@0.24.2": true,
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.0": true
  }
}
